# ── LLM ──────────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── AWS S3 (durable storage for index + PDFs) ─────────────────────────────────
# S3 bucket name (must already exist and be accessible by your credentials)
AWS_S3_BUCKET=your_s3_bucket_name

# Key prefix inside the bucket (optional, defaults to "rag-qa")
AWS_S3_PREFIX=rag-qa

# AWS credentials are read from the standard chain:
#   1. These env vars (set them here for local dev)
#   2. ~/.aws/credentials
#   3. EC2 / ECS IAM role (recommended for production)
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_DEFAULT_REGION=us-east-1
